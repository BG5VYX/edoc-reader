<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:scrollbars="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:lineSpacingExtra="3dp"
        android:text="芯片访问只需三个要素：证件号、出生日期、有效期。填这三项即可，不必输入完整机读区。"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/app_on_surface_variant" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/btnMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeFields"
            style="?attr/materialButtonOutlinedStyle"
            android:checked="true"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="填三要素" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeMrz"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="粘贴完整 MRZ" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- ==================== 三要素模式（默认） ==================== -->
    <LinearLayout
        android:id="@+id/groupFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDocNo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="证件号码（9 位，含字母）"
            app:counterEnabled="true"
            app:counterMaxLength="9"
            app:helperText="例如 EF1260892（护照）、CA3273201（通行证）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDocNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="9"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDob"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="出生日期（6 位）"
            app:helperText="例如 1981 年 8 月 3 日 → 810803">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="number"
                android:maxLength="8"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilExpiry"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="有效期至（6 位）"
            app:helperText="例如 2029 年 1 月 17 日 → 290117">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExpiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="number"
                android:maxLength="8"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="三个校验位会自动计算，无需手工输入。也可以直接填 8 位日期（如 19810803），会自动取后 6 位。"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/app_on_surface_variant" />
    </LinearLayout>

    <!-- ==================== 完整 MRZ 模式 ==================== -->
    <LinearLayout
        android:id="@+id/groupMrz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:lineSpacingExtra="3dp"
            android:text="按证件上印刷的内容逐行输入机读区。护照 2 行 × 44 字符，往来港澳/台湾通行证 3 行 × 30 字符。整段粘贴也可以，会自动拆行。"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/app_on_surface_variant" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLine1"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="第 1 行">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLine1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="44"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLine2"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="第 2 行">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="44"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLine3"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="第 3 行（通行证等 TD1 证件需要）">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLine3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="44"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvParseResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textColor="@color/app_on_surface_variant"
        tools:text="已解析：证件号 EF1260892，出生 1985-03-20，有效期至 2029-01-17" />
</LinearLayout>
</ScrollView>
