<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/迁移规则：证件记录一律不参与云备份与设备迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="records/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="records/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
